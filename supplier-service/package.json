  "//": "AI Assistance Disclosure: see AI-DISCLOSURES.md#strict-json-files. OpenAI Codex (GPT-6), 2026-09-25; Supplier backend package configuration. Strict-JSON metadata exception requires course-owner approval and author review before submission.",
  "name": "foc-supplier-service",
  "version": "0.1.0",
  "private": true,
  "description": "FoC Supplier Service backend",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed/run.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "csv-parse": "^7.0.2",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
