        },
        "suppliers_coordinates_paired": {
          "name": "suppliers_coordinates_paired",
          "value": "(\"suppliers\".\"latitude\" is null) = (\"suppliers\".\"longitude\" is null)"
        },
        "suppliers_latitude_range": {
          "name": "suppliers_latitude_range",
          "value": "\"suppliers\".\"latitude\" is null or \"suppliers\".\"latitude\" between -90 and 90"
        },
        "suppliers_longitude_range": {
          "name": "suppliers_longitude_range",
          "value": "\"suppliers\".\"longitude\" is null or \"suppliers\".\"longitude\" between -180 and 180"
        },
        "suppliers_hours_consistent": {
          "name": "suppliers_hours_consistent",
          "value": "(\n        \"suppliers\".\"hours_kind\" in ('UNKNOWN', 'ALL_DAY')\n        and \"suppliers\".\"opens_at\" is null\n        and \"suppliers\".\"closes_at\" is null\n      ) or (\n        \"suppliers\".\"hours_kind\" = 'INTERVAL'\n        and \"suppliers\".\"opens_at\" is not null\n        and \"suppliers\".\"closes_at\" is not null\n        and \"suppliers\".\"opens_at\" <> \"suppliers\".\"closes_at\"\n      )"
        },
        "suppliers_version_nonnegative": {
          "name": "suppliers_version_nonnegative",
          "value": "\"suppliers\".\"version\" >= 0"
        },
        "suppliers_archive_state_consistent": {
          "name": "suppliers_archive_state_consistent",
          "value": "(\n        \"suppliers\".\"status\" = 'ACTIVE' and \"suppliers\".\"archived_at\" is null\n      ) or (\n        \"suppliers\".\"status\" = 'ARCHIVED' and \"suppliers\".\"archived_at\" is not null\n      )"
        }
