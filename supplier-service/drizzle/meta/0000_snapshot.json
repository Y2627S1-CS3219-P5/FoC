      "checkConstraints": {
        "suppliers_name_nonblank": {
          "name": "suppliers_name_nonblank",
          "value": "btrim(\"suppliers\".\"name\") <> ''"
        },
        "suppliers_building_code_nonblank": {
          "name": "suppliers_building_code_nonblank",
