# AI Assistance Disclosure: OpenAI Codex (GPT-6), 2026-09-25. Scope: merged the User and Supplier service environment examples without changing either service's configuration contract. Author review: Reviewed and approved by @ron.
# Additional AI assistance: OpenAI Codex (GPT-6), 2026-09-25. Scope: documented required Supplier User Service verification configuration for issue #16. Author review: Reviewed and approved by @ron.
# Additional AI assistance: OpenAI Codex (GPT-6), 2026-09-25. Scope: recorded the approved Supplier verification deployment timeout for issue #17. Author review of additional changes: Reviewed and approved by @ron.
# Additional AI assistance: OpenAI Codex (GPT-6), 2026-09-25. Scope: documented the configurable User Service host port used by the isolated Supplier integration check. Author review of additional changes: Reviewed and approved by @ron.
# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Auth / JWT -----------
# Long random string, e.g. output of: openssl rand -hex 32
JWT_SECRET=
# Access token lifetime in seconds
JWT_ACCESS_TOKEN_TTL=1800
JWT_REFRESH_TOKEN_TTL=

# ---- Supplier Service ---------------------------------------
SUPPLIER_PORT=3000
SUPPLIER_DB_NAME=supplier
SUPPLIER_DB_ADMIN_USER=supplier_bootstrap
SUPPLIER_DB_ADMIN_PASSWORD=
SUPPLIER_DB_MIGRATION_USER=supplier_migrator
SUPPLIER_DB_MIGRATION_PASSWORD=
SUPPLIER_DB_USER=supplier_app
SUPPLIER_DB_PASSWORD=
# Used when running Supplier directly; Compose uses http://user-service:3001.
USER_SERVICE_BASE_URL=http://localhost:3001
# Bounded User Service verification timeout in milliseconds.
USER_SERVICE_VERIFY_TIMEOUT_MS=1000

# ---- User service ----------
USER_PORT=3001
ALLOWED_EMAIL_DOMAIN=u.nus.edu
# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# First administrator, created once at startup if no admin exists. Leave all three
# empty to skip. Password: 12+ chars with upper, lower and digit.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ... Add more variables as needed
