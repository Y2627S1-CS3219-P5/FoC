# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# Kafka configuration for services run directly. Compose uses kafka:9092 and per-service IDs.
# The broker's advertised listener must be reachable from the direct-running service.
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=

# ---- Auth / JWT -----------
# Long random string, e.g. output of: openssl rand -hex 32
JWT_SECRET=
# Access token lifetime in seconds
JWT_ACCESS_TOKEN_TTL=1800
JWT_REFRESH_TOKEN_TTL=

# ---- Supplier Service ---------------------------------------
SUPPLIER_PORT=3000
SUPPLIER_DB_NAME=supplier
SUPPLIER_DB_ADMIN_USER=supplier_bootstrap
SUPPLIER_DB_ADMIN_PASSWORD=
SUPPLIER_DB_MIGRATION_USER=supplier_migrator
SUPPLIER_DB_MIGRATION_PASSWORD=
SUPPLIER_DB_USER=supplier_app
SUPPLIER_DB_PASSWORD=
# Used when running Supplier directly; Compose uses http://user-service:3001.
USER_SERVICE_BASE_URL=http://localhost:3001
# Bounded User Service verification timeout in milliseconds.
USER_SERVICE_VERIFY_TIMEOUT_MS=1000

# ---- Frontend (gateway) ------------------------------------
# The website and all browser API calls go through http://localhost:$FRONTEND_PORT
FRONTEND_PORT=8080

# ---- User service ----------
USER_PORT=3001
ALLOWED_EMAIL_DOMAIN=u.nus.edu
# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# User Service database passwords (the role names are fixed: user_bootstrap,
# user_migrator, user_app). Use letters and digits only, because they are placed
# inside connection URLs, e.g. output of: openssl rand -hex 16
USER_DB_ADMIN_PASSWORD=
USER_DB_MIGRATION_PASSWORD=
USER_DB_APP_PASSWORD=

# Key for the User Service audit-log hash chain: at least 32 random bytes in hex.
# Generate once with: openssl rand -hex 32. Never change it afterwards (old entries
# would no longer verify).
AUDIT_HMAC_KEY=

# First administrator, created once at startup if no admin exists. Leave all three
# empty to skip. Password: 12+ chars with upper, lower and digit.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Order service ----------
ORDER_PORT=3002
# Order Service database passwords (the role names are fixed: order_bootstrap,
# order_migrator, order_app). Letters and digits only, e.g. openssl rand -hex 16
ORDER_DB_ADMIN_PASSWORD=
ORDER_DB_MIGRATION_PASSWORD=
ORDER_DB_APP_PASSWORD=
# Minutes the requester has to confirm a delivery before it completes automatically
CONFIRMATION_WINDOW_MINUTES=1440
# Seconds Credit has to answer a reservation before the errand times out
RESERVATION_TIMEOUT_SECONDS=30
# How Order Service reaches Credit Service: kafka (default, the real credit-service) or stub
# (in-memory stand-in for the demo script; the STUB_CREDIT_* settings apply only to it)
ORDER_CREDIT_MODE=kafka
# How Order Service checks sessions: http (default, the User Service's GET /auth/verify) or stub
# (believes any "stub.<uuid>.<role>" token)
ORDER_AUTH_MODE=http
# Stub Credit: reserve requests above this amount are rejected
STUB_CREDIT_LIMIT=100
# Stub Credit: a request for exactly this amount gets no reply (shows the timeout)
STUB_CREDIT_SILENT_AMOUNT=999
# Milliseconds Order waits for the User Service's session check before answering 503
ORDER_USER_SERVICE_VERIFY_TIMEOUT_MS=1000
# Milliseconds Order waits for the Supplier Service's supplier lookup before answering 503
ORDER_SUPPLIER_SERVICE_LOOKUP_TIMEOUT_MS=2000

# ---- Credit service ----------
# Credit Service database passwords (the role names are fixed: credit_bootstrap,
# credit_migrator, credit_app). Letters and digits only, e.g. openssl rand -hex 16
CREDIT_DB_ADMIN_PASSWORD=
CREDIT_DB_MIGRATION_PASSWORD=
CREDIT_DB_APP_PASSWORD=

# ... Add more variables as needed
