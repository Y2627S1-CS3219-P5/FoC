# Scope: Non-secret local logging setup placeholders for issue #66.
# Author review: Reviewed and approved by @ron on 2026-11-10.

# Match the application's project name shown by `docker compose ls`.
APP_COMPOSE_PROJECT=foc
GRAFANA_ADMIN_USER=admin
# Fill this in only in your gitignored observability/.env.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3300

# This is a Docker-daemon host path; Docker Desktop normally provides this socket.
DOCKER_SOCKET_PATH=/var/run/docker.sock
